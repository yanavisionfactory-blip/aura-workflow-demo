{
  "name": "WorkflowRun",
  "type": "object",
  "properties": {
    "prompt": {
      "type": "string",
      "description": "The original user request"
    },
    "title": {
      "type": "string",
      "description": "Human-readable outcome title (e.g. Leads routed to sales team)"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "completed",
        "failed"
      ],
      "default": "running"
    },
    "workflow_id": {
      "type": "string",
      "description": "The saved Workflow this run belongs to"
    },
    "summary": {
      "type": "string",
      "description": "One-sentence outcome summary"
    },
    "steps": {
      "type": "array",
      "description": "Executed steps with tool, action, and output",
      "items": {
        "type": "object"
      }
    },
    "outcomes": {
      "type": "array",
      "description": "Key results (what was created, sent, updated)",
      "items": {
        "type": "object"
      }
    },
    "metrics": {
      "type": "array",
      "description": "Key metrics from the run",
      "items": {
        "type": "object"
      }
    },
    "notes": {
      "type": "string",
      "description": "Any important notes or warnings"
    },
    "duration_seconds": {
      "type": "number",
      "description": "How long the workflow took"
    }
  },
  "required": [
    "prompt",
    "status"
  ]
}