{
  "description": "Sends first-outreach emails to creators the manager has approved in AURA, then marks them emailed. Runs daily at 9am.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "send_approved_outreach",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_outreach": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendApprovedOutreach",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Send approved outreach",
            "description": "Email approved creators only"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Send Approved Outreach"
}