ENVIRONMENT=development
PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql+psycopg://aura:aura@postgres:5432/aura
REDIS_URL=redis://redis:6379/0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Permanent browser-independent run ownership and bounded planning recovery.
RECOVERY_SCHEDULER_ENABLED=true
SCHEDULER_TICK_TIMEOUT_SECONDS=300
MAX_PLANNING_RECOVERY_ROUNDS=8
RECOVERY_ENGINEER_ENABLED=true
MAX_RECOVERY_ENGINEER_ATTEMPTS=3
CONNECTION_PROBE_TTL_SECONDS=60
# Opaque repository-dispatch handoff to the isolated repair workflow.
RECOVERY_GITHUB_REPOSITORY=yanavisionfactory-blip/aura-workflow-demo
RECOVERY_GITHUB_TOKEN=
# Use the same random secret as the GitHub Actions callback secret.
RECOVERY_PIPELINE_CALLBACK_SECRET=
# Dynamic Nango capability-pack release controller. Customer connections are
# never used for canaries. Map provider/integration IDs only to dedicated test
# connection IDs, for example {"linear":"aura-canary-linear"}.
CONNECTOR_ENGINEER_ENABLED=true
CONNECTOR_ENGINEER_SIGNING_KEY=
CONNECTOR_ENGINEER_CANARY_CONNECTIONS_JSON={}
CONNECTOR_ENGINEER_ALLOWED_PROVIDERS_JSON=[]
CONNECTOR_ENGINEER_SCAN_INTERVAL_SECONDS=300
CONNECTOR_ENGINEER_CANARY_TTL_SECONDS=86400
# Write packs remain disabled unless their Nango metadata declares a canary
# input and deterministic read-back operation.
CONNECTOR_ENGINEER_ALLOW_WRITES=false
# Bounded self-healing. AURA may revise only already-approved read operations;
# writes, new permissions and new literal resource targets always stop for review.
MAX_AUTONOMOUS_READ_REPAIRS=3
CREDENTIAL_ENCRYPTION_KEY=
# During key rotation, put retired keys here, newest first, comma-separated.
CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=
SESSION_SIGNING_KEY=
# Production identity (Clerk). Prefer CLERK_JWT_KEY for networkless verification.
CLERK_JWT_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
ALLOW_LEGACY_WORKSPACE_TOKENS=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
MAILCHIMP_CLIENT_ID=
MAILCHIMP_CLIENT_SECRET=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
